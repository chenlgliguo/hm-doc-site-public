---
import { getCollection } from "astro:content";
import DocumentPrototypePage from "../components/DocumentPrototypePage.astro";

const documents = await getCollection("documents");
const documentEntry = documents.find(
  (entry) => entry.data.slug === "management-evaluation-pro-v3-2"
);

if (!documentEntry) {
  throw new Error("未找到 slug 为 management-evaluation-pro-v3-2 的 documents 文档");
}
---

<DocumentPrototypePage
  title={documentEntry.data.title}
  summary={documentEntry.data.summary}
  markdownContent={documentEntry.body}
/>
